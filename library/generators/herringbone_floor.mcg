# Wooden herringbone parquet: height, normal and brick ids
size 2048
node 1 herringbone scale=8 gap=2 bevel=4 variation=0.3 mode=0
node 2 herringbone scale=8 gap=2 bevel=4 variation=0.3 mode=1
node 3 normal in=@1 strength=6
output height 1
output normal 3
output brick_id 2
expose "Brick count" 1 scale 3 24
expose "Gap" 1 gap 0 10
