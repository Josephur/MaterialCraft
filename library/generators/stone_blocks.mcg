# Rough-cut stone block pattern with height and ids
size 1024
node 1 bricks rows=6 cols=3 mortar=0.05 bevel=0.12 offset=0.5 lum_var=0.6 seed=4
node 2 fbm scale=10 octaves=5 seed=2
node 3 blend fg=@2 bg=@1 mode=1 opacity=0.1
node 4 normal in=@3 strength=4
output height 3
output normal 4
output ids 1
expose "Rows" 1 rows 2 16
expose "Columns" 1 cols 1 8
