# Round beads threaded on a wavy string
size 2048
node 1 path_scatter preset=2 amplitude=0.15 frequency=2 spacing=64 scale=56 scale_variation=0 rotation=1
node 2 path_stroke preset=2 amplitude=0.15 frequency=2 width=10 profile=1
node 3 blur in=@1 radius=7
node 4 blend fg=@3 bg=@2 mode=6 opacity=1
node 5 normal in=@4 strength=5
output height 4
output normal 5
output beads 1
expose "Bead spacing" 1 spacing 20 200
expose "Bead size" 1 scale 10 120
