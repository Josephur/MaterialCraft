# Railway track on gravel: rails, sleepers and ballast with height and normal
size 2048
node 1 path_track preset=0 gauge=150 rail_width=18 sleeper_spacing=70 sleeper_length=300 sleeper_width=36 rail_height=0.95 sleeper_height=0.6
node 2 cells scale=90 jitter=0.9 seed=2 edge_width=0.3 hardness=0.6
node 3 levels in=@2 out_low=0 out_high=0.3
node 4 blend fg=@1 bg=@3 mode=6 opacity=1
node 5 normal in=@4 strength=4
output height 4
output normal 5
output rails 1.rails
output sleepers 1.sleepers
expose "Rail distance" 1 gauge 40 300
expose "Sleeper spacing" 1 sleeper_spacing 30 200
