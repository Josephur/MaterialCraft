# Three rows of cobbles along a wavy path, bent a little by a warp
size 2048
node 1 path_splatter preset=2 amplitude=0.12 frequency=2 rows=3 row_spacing=34 spacing=34 scale=40 scale_variation=0.25 jitter_along=0.3 jitter_across=4 rotation=2 seed=5
node 2 blur in=@1 radius=5
node 3 fbm scale=6 octaves=4
node 4 path_warp in=@2 preset=2 amplitude=0.12 frequency=2 width=160 amount=20 mode=0
node 5 normal in=@4 strength=5
output height 4
output normal 5
expose "Cobble size" 1 scale 16 90
expose "Rows" 1 rows 1 6
