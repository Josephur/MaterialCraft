# Fan-shaped arc pavement: height, normal and stone ids
size 2048
node 1 arc_pavement scale=4 rings=4 stones=9 gap=2 bevel=4 variation=0.3 mode=0
node 2 arc_pavement scale=4 rings=4 stones=9 gap=2 bevel=4 variation=0.3 mode=1
node 3 normal in=@1 strength=6
output height 1
output normal 3
output stone_id 2
expose "Fans" 1 scale 2 12
expose "Stones per ring" 1 stones 5 16
