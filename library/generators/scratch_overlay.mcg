# Layered scratches: fine, medium and deep
size 1024
node 1 scratches count=260 length=90 thickness=0.8 angle_variation=0.5 seed=1
node 2 scratches count=90 length=240 thickness=1.1 angle_variation=0.3 seed=2
node 3 scratches count=18 length=420 thickness=1.8 angle=0.1 angle_variation=0.1 seed=3
node 4 blend fg=@2 bg=@1 mode=6 opacity=0.85
node 5 blend fg=@3 bg=@4 mode=6 opacity=1
output output 5
expose "Fine scratches" 1 count 0 800
expose "Deep scratches" 3 count 0 80
