# Three-strand rope along a wavy line, with height, strand ids and normal
size 2048
node 1 path_cable preset=2 amplitude=0.18 frequency=1 width=110 strands=3 strand_size=0.5 twist=5
node 2 fbm scale=60 octaves=3 seed=3
node 3 blend fg=@2 bg=@1 mode=1 opacity=0.05
node 4 normal in=@3 strength=3
output height 3
output normal 4
output mask 1.mask
output strands 1.strand
expose "Strands" 1 strands 2 8
expose "Twists" 1 twist 0 12
expose "Rope width" 1 width 20 200
