# Crumpled sheet: sharp creases over soft folds
size 1024
node 1 voronoi scale=6 jitter=1 seed=3 mode=4
node 2 fbm scale=4 octaves=5 mode=1 seed=6
node 3 levels in=@1 low=0 high=0.3
node 4 blend fg=@2 bg=@3 mode=5 opacity=0.6
node 5 normal in=@4 strength=3
output height 4
output normal 5
expose "Fold count" 1 scale 2 14
