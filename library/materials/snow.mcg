# Fresh snow: soft drifts, fine granular surface, blue shadows in the hollows and glinting crystals
size 2048
node 1 perlin scale=3 seed=3
node 2 fbm scale=6 octaves=6 seed=5
node 3 blend fg=@2 bg=@1 mode=5 opacity=0.5
node 4 fbm scale=40 octaves=3 seed=7
node 5 blend fg=@4 bg=@3 mode=5 opacity=0.12
node 6 fbm scale=170 octaves=2 seed=9
node 7 blend fg=@6 bg=@5 mode=5 opacity=0.035
node 8 normal in=@7 strength=1.6
node 9 ao in=@5 radius=16 intensity=1.6
node 10 colorize in=@5 p0=0 r0=0.76 g0=0.83 b0=0.92 p1=0.5 r1=0.89 g1=0.92 b1=0.96 p2=1 r2=0.97 g2=0.975 b2=0.985
node 11 invert in=@9
node 12 color r=0.58 g=0.7 b=0.88
node 13 blend fg=@12 bg=@10 mask=@11 mode=0 opacity=0.7
node 14 voronoi scale=300 jitter=1 seed=11 mode=1
node 15 levels in=@14 low=0.965 high=0.97
node 16 color r=1 g=1 b=1
node 17 blend fg=@16 bg=@13 mask=@15 mode=0 opacity=0.45
node 18 fbm scale=12 octaves=3 seed=13
node 19 levels in=@18 out_low=0.55 out_high=0.75
node 20 levels in=@15 out_low=0 out_high=0.45
node 21 blend fg=@20 bg=@19 mode=2 opacity=1
node 22 color r=0 g=0 b=0
output basecolor 17
output height 7
output normal 8
output ambient_occlusion 9
output roughness 21
output metallic 22
expose "Drift scale" 1 scale 2 10
expose "Sparkle" 15 low 0.85 0.995
expose "Bumpiness" 8 strength 0 6
