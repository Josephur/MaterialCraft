# Glazed ceramic floor tiles with grout
size 2048
node 1 bricks rows=5 cols=5 mortar=0.025 bevel=0.03 offset=0 lum_var=0.25 seed=3
node 2 fbm scale=6 octaves=5 seed=2
node 3 fbm scale=64 octaves=2 seed=3
node 4 levels in=@1 low=0 high=0.1
node 5 blend fg=@3 bg=@4 mode=1 opacity=0.02
node 6 normal in=@5 strength=2
node 7 ao in=@4 radius=5 intensity=2.5
node 8 colorize in=@1 p0=0 r0=0.55 g0=0.62 b0=0.68 p1=1 r1=0.75 g1=0.82 b1=0.88
node 9 blend fg=@2 bg=@8 mode=5 opacity=0.2
node 10 color r=0.12 g=0.12 b=0.11
node 11 blend fg=@9 bg=@10 mask=@4 mode=0 opacity=1
node 12 blend fg=@7 bg=@11 mode=3 opacity=0.8
node 13 levels in=@4 out_low=0.85 out_high=0.18
node 14 color r=0 g=0 b=0
output basecolor 12
output height 5
output normal 6
output ambient_occlusion 7
output roughness 13
output metallic 14
expose "Tiles per side" 1 cols 2 12
expose "Grout width" 1 mortar 0 0.12
