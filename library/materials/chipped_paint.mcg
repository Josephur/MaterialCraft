# Painted steel with chipped paint
size 2048
node 1 grunge_map map=22 seed=3 coverage=0.9 contrast=0.95 invert=1
node 2 fbm scale=22 octaves=5 seed=4
node 3 scratches count=90 length=180 thickness=1.2 angle_variation=0.5 seed=2
node 4 blend fg=@2 bg=@1 mode=6 opacity=0.4
node 5 levels in=@4 low=0.45 high=0.6
node 6 fbm scale=60 octaves=3 seed=6
node 7 levels in=@3 out_low=0.45 out_high=0.52
node 8 levels in=@6 out_low=0.55 out_high=0.6
node 9 blend fg=@7 bg=@8 mask=@5 mode=0 opacity=1
node 10 normal in=@9 strength=4
node 11 ao in=@9 radius=6 intensity=2.2
node 12 color r=0.1 g=0.25 b=0.55
node 13 color r=0.45 g=0.46 b=0.48
node 14 blend fg=@13 bg=@12 mask=@5 mode=0 opacity=1
node 15 blend fg=@11 bg=@14 mode=3 opacity=0.8
node 16 levels in=@5 out_low=0.4 out_high=0.3
node 17 levels in=@5 out_low=0.0 out_high=1
output basecolor 15
output height 9
output normal 10
output ambient_occlusion 11
output roughness 16
output metallic 17
expose "Paint wear" 5 low 0.2 0.8
