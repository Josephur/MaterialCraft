# Grained leather with a stitched seam
size 2048
node 1 cells scale=38 jitter=0.85 seed=3 variant=0 edge_width=0.25 hardness=0.8
node 2 fbm scale=6 octaves=4 seed=5
node 3 fbm scale=90 octaves=3 seed=7
node 4 blend fg=@3 bg=@1 mode=5 opacity=0.35
node 5 blend fg=@2 bg=@4 mode=1 opacity=0.08
node 6 normal in=@5 strength=3.5
node 7 ao in=@1 radius=5 intensity=2
node 8 colorize in=@5 p0=0 r0=0.1 g0=0.05 b0=0.03 p1=0.6 r1=0.27 g1=0.14 b1=0.07 p2=1 r2=0.37 g2=0.2 b2=0.1
node 9 blend fg=@7 bg=@8 mode=3 opacity=0.7
node 10 levels in=@3 out_low=0.4 out_high=0.65
node 11 color r=0 g=0 b=0
node 20 path_seam preset=0 stitch_length=60 stitch_gap=36 stitch_width=14 groove_width=40 groove_depth=0.6 stitch_height=0.8
node 21 blend fg=@20 bg=@5 mode=16 opacity=1
node 22 normal in=@21 strength=3.5
node 23 color r=0.78 g=0.7 b=0.52
node 24 blend fg=@23 bg=@9 mask=@20.stitches mode=0 opacity=1
node 26 levels in=@20 low=0.3 high=0.5 out_low=1 out_high=0
node 27 color r=0 g=0 b=0
node 28 blend fg=@27 bg=@24 mask=@26 mode=0 opacity=0.45
output basecolor 28
output height 21
output normal 22
output ambient_occlusion 7
output roughness 10
output metallic 11
expose "Grain size" 1 scale 12 80
expose "Stitch length" 20 stitch_length 20 200
expose "Stitch gap" 20 stitch_gap 4 120
