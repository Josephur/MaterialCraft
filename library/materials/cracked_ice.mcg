# Frozen lake ice: deep blue-green ice with white fractures, frosted patches and trapped bubbles
size 2048
node 1 voronoi scale=4 jitter=1 seed=2 mode=4 distortion=0.18 distortion_scale=10
node 2 levels in=@1 low=0 high=0.012
node 3 voronoi scale=10 jitter=1 seed=6 mode=4 distortion=0.25 distortion_scale=14
node 4 levels in=@3 low=0 high=0.008
node 5 fbm scale=5 octaves=3 seed=8
node 6 levels in=@5 low=0.4 high=0.6 out_low=1 out_high=0
node 7 blend fg=@6 bg=@4 mode=6 opacity=1
node 8 blend fg=@7 bg=@2 mode=7 opacity=1
node 9 invert in=@8
node 10 blur in=@9 radius=3
node 11 clouds scale=5 seed=3
node 12 colorize in=@11 p0=0 r0=0.06 g0=0.17 b0=0.26 p1=0.55 r1=0.2 g1=0.4 b1=0.52 p2=1 r2=0.48 g2=0.66 b2=0.76
node 13 fbm scale=8 octaves=6 seed=10
node 14 levels in=@13 low=0.64 high=0.8
node 15 color r=0.84 g=0.89 b=0.94
node 16 blend fg=@15 bg=@12 mask=@14 mode=0 opacity=0.85
node 17 color r=0.9 g=0.95 b=1
node 18 blend fg=@17 bg=@16 mask=@10 mode=0 opacity=0.55
node 19 blend fg=@17 bg=@18 mask=@9 mode=0 opacity=0.9
node 20 gaussian_spots scale=110 size=0.18 size_variation=0.8 seed=12
node 21 levels in=@20 low=0.7 high=0.85
node 22 blend fg=@17 bg=@19 mask=@21 mode=0 opacity=0.45
node 23 levels in=@14 out_low=0.5 out_high=0.56
node 24 blend fg=@9 bg=@23 mode=2 opacity=0.05
node 25 normal in=@24 strength=2.5
node 26 levels in=@14 out_low=0.05 out_high=0.55
node 27 blend fg=@10 bg=@26 mode=6 opacity=0.4
node 28 color r=0 g=0 b=0
output basecolor 22
output height 24
output normal 25
output roughness 27
output metallic 28
expose "Crack size" 1 scale 2 12
expose "Fine cracks" 3 scale 5 30
expose "Frost" 14 low 0.35 0.95
