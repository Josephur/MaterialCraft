# Cobblestone street
size 2048
node 1 paving scale=7 jitter=0.55 gap=0.05 bevel=0.12 height_variation=0.35 dome=0.4 seed=4
node 2 fbm scale=10 octaves=5 seed=11
node 3 fbm scale=48 octaves=3 seed=12
node 4 blend fg=@2 bg=@1 mode=1 opacity=0.12
node 5 blend fg=@3 bg=@4 mode=1 opacity=0.05
node 6 normal in=@5 strength=4
node 7 ao in=@5 radius=8 intensity=2.5
node 8 colorize in=@1.cell_id p0=0 r0=0.30 g0=0.28 b0=0.26 p1=0.5 r1=0.45 g1=0.42 b1=0.38 p2=1 r2=0.58 g2=0.52 b2=0.45
node 9 blend fg=@2 bg=@8 mode=5 opacity=0.45
node 10 levels in=@5 low=0 high=0.4 out_low=0.15 out_high=1
node 11 blend fg=@10 bg=@9 mode=3 opacity=1
node 12 blend fg=@7 bg=@11 mode=3 opacity=1
node 13 levels in=@3 low=0.2 high=0.8 out_low=0.65 out_high=0.95
node 14 color r=0 g=0 b=0
output basecolor 12
output height 5
output normal 6
output ambient_occlusion 7
output roughness 13
output metallic 14
expose "Stone count" 1 scale 3 14
expose "Gap width" 1 gap 0 0.2
expose "Relief" 6 strength 0 10
