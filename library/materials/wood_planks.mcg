# Wooden floor planks
size 2048
node 1 stripes count=7 angle=0 softness=0.004 width=0.965
node 2 flood_fill_random in=@1
node 3 waveform count=26 angle=0 warp=0.6 warp_scale=4 seed=2 shape=0
node 4 directional_noise scale=5 stretch=26 angle=0 seed=5
node 5 fbm scale=3 octaves=3 seed=8
node 6 blend fg=@4 bg=@3 mode=5 opacity=0.7
node 7 blend fg=@2 bg=@6 mode=1 opacity=0.6
node 8 blend fg=@5 bg=@7 mode=5 opacity=0.25
node 9 levels in=@1 low=0 high=0.2
node 10 blend fg=@4 bg=@9 mode=1 opacity=0.05
node 11 normal in=@10 strength=2.2
node 12 ao in=@9 radius=7 intensity=2.4
node 13 colorize in=@8 p0=0 r0=0.17 g0=0.09 b0=0.04 p1=0.5 r1=0.4 g1=0.23 b1=0.1 p2=1 r2=0.58 g2=0.37 b2=0.18
node 14 levels in=@9 out_low=0.1 out_high=1
node 15 blend fg=@14 bg=@13 mode=3 opacity=1
node 16 blend fg=@12 bg=@15 mode=3 opacity=0.7
node 17 levels in=@4 low=0.2 high=0.8 out_low=0.45 out_high=0.7
node 18 color r=0 g=0 b=0
output basecolor 16
output height 10
output normal 11
output ambient_occlusion 12
output roughness 17
output metallic 18
expose "Plank count" 1 count 2 16
expose "Grain scale" 4 scale 2 16
