# Bare steel with spreading rust
size 2048
node 1 grunge_map map=7 seed=2 balance=0.5 invert=1
node 2 fbm scale=6 octaves=6 seed=3
node 3 fbm scale=40 octaves=4 seed=4
node 4 blend fg=@2 bg=@1 mode=1 opacity=0.35
node 5 levels in=@4 low=0.5 high=0.78
node 6 scratches count=140 length=260 thickness=1.1 angle=0.02 angle_variation=0.04 seed=5
node 7 levels in=@6 out_low=0.5 out_high=0.56
node 8 blend fg=@3 bg=@7 mask=@5 mode=0 opacity=1
node 9 normal in=@8 strength=3
node 10 ao in=@8 radius=7 intensity=2.2
node 11 color r=0.52 g=0.53 b=0.56
node 12 colorize in=@2 p0=0 r0=0.18 g0=0.07 b0=0.03 p1=0.55 r1=0.45 g1=0.2 b1=0.07 p2=1 r2=0.62 g2=0.33 b2=0.12
node 13 blend fg=@12 bg=@11 mask=@5 mode=0 opacity=1
node 14 blend fg=@10 bg=@13 mode=3 opacity=0.9
node 15 invert in=@5
node 16 levels in=@5 out_low=0.32 out_high=0.88
output basecolor 14
output height 8
output normal 9
output ambient_occlusion 10
output roughness 16
output metallic 15
expose "Rust spread" 5 low 0.2 0.8
expose "Relief" 9 strength 0 8
