# Galvanised chain-link fence
size 2048
node 1 wire_mesh count_x=14 count_y=14 wire_width=0.16 weave_depth=0.6 mode=1
node 2 threshold in=@1 threshold=0.03 softness=0.02
node 3 fbm scale=10 octaves=5 seed=2
node 4 normal in=@1 strength=3
node 5 ao in=@1 radius=3 intensity=2
node 6 color r=0.62 g=0.64 b=0.66
node 7 blend fg=@3 bg=@6 mode=5 opacity=0.25
node 8 blend fg=@5 bg=@7 mode=3 opacity=0.6
node 9 levels in=@3 out_low=0.3 out_high=0.6
node 10 color r=1 g=1 b=1
output basecolor 8
output height 1
output normal 4
output ambient_occlusion 5
output roughness 9
output metallic 10
output opacity 2
expose "Mesh density" 1 count_x 4 40
