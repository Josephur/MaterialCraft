# Wind-blown sand with fine ripples
size 2048
node 1 waveform count=18 angle=0.08 warp=0.7 warp_scale=3 seed=3 shape=0
node 2 fbm scale=5 octaves=5 seed=4
node 3 gaussian_noise scale=1 seed=6
node 4 blend fg=@2 bg=@1 mode=5 opacity=0.55
node 5 blend fg=@3 bg=@4 mode=1 opacity=0.045
node 6 normal in=@5 strength=2.5
node 7 ao in=@4 radius=10 intensity=1.6
node 8 colorize in=@4 p0=0 r0=0.55 g0=0.42 b0=0.26 p1=0.55 r1=0.78 g1=0.64 b1=0.42 p2=1 r2=0.9 g2=0.78 b2=0.55
node 9 blend fg=@7 bg=@8 mode=3 opacity=0.7
node 10 levels in=@3 out_low=0.8 out_high=1
node 11 color r=0 g=0 b=0
output basecolor 9
output height 5
output normal 6
output ambient_occlusion 7
output roughness 10
output metallic 11
expose "Ripple count" 1 count 4 40
