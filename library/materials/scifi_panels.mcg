# Sci-fi hull panels: painted plates with recessed and subdivided panels, rivets, vents, worn edges and light strips
size 2048
node 1 bricks rows=4 cols=4 mortar=0.012 bevel=0.01 offset=0 lum_var=1 seed=3
node 2 levels in=@1 low=0 high=0.01
node 3 bricks rows=8 cols=8 mortar=0.02 bevel=0.01 offset=0 lum_var=1 seed=7
node 4 levels in=@3 low=0 high=0.01
node 5 levels in=@1 low=0.62 high=0.63
node 6 blend fg=@4 bg=@2 mask=@5 mode=0 opacity=1
node 7 levels in=@1 low=0.3 high=0.31 out_low=0.5 out_high=0.62
node 8 blend fg=@6 bg=@7 mode=3 opacity=1
node 9 blur in=@8 radius=1.5
node 10 tile_sampler x_amount=8 y_amount=8 size=0.16 pattern_type=3
node 11 invert in=@5
node 12 blend fg=@11 bg=@10 mode=3 opacity=1
node 13 blend fg=@12 bg=@9 mode=1 opacity=0.18
node 14 stripes count=64 angle=0 width=0.45 softness=0.3
node 15 levels in=@1 low=0.42 high=0.43
node 50 levels in=@1 low=0.54 high=0.55 out_low=1 out_high=0
node 51 blend fg=@50 bg=@15 mode=3 opacity=1
node 16 tile_sampler x_amount=4 y_amount=4 size=0.62 pattern_type=1
node 17 blend fg=@16 bg=@51 mode=3 opacity=1
node 41 blend fg=@11 bg=@17 mode=3 opacity=1
node 18 blend fg=@14 bg=@41 mode=3 opacity=1
node 19 blend fg=@18 bg=@13 mode=2 opacity=0.12
node 20 normal in=@19 strength=4
node 21 ao in=@19 radius=5 intensity=2.2
node 22 colorize in=@1 interp=2 p0=0 r0=0.04 g0=0.04 b0=0.045 p1=0.02 r1=0.14 g1=0.15 b1=0.17 p2=0.3 r2=0.56 g2=0.58 b2=0.61 p3=0.92 r3=0.85 g3=0.38 b3=0.08 p4=1 r4=0.85 g4=0.38 b4=0.08
node 24 convex_concave in=@8 radius=6 gain=6
node 46 fbm scale=14 octaves=5 seed=17
node 47 levels in=@46 low=0.45 high=0.62
node 48 blend fg=@47 bg=@24 mode=3 opacity=1
node 49 levels in=@48 low=0.2 high=0.42
node 25 color r=0.7 g=0.71 b=0.73
node 26 blend fg=@25 bg=@22 mask=@49 mode=0 opacity=1
node 43 fbm scale=8 octaves=6 seed=9
node 44 blend fg=@43 bg=@26 mode=5 opacity=0.14
node 27 blend fg=@21 bg=@44 mode=3 opacity=0.85
node 28 levels in=@1 low=0.1 high=0.11
node 29 levels in=@1 low=0.2 high=0.21 out_low=1 out_high=0
node 30 blend fg=@29 bg=@28 mode=3 opacity=1
node 31 stripes count=8 angle=0 width=0.05 softness=0.4
node 32 blend fg=@31 bg=@30 mode=3 opacity=1
node 33 color r=0.15 g=0.85 b=1
node 34 color r=0 g=0 b=0
node 35 blend fg=@33 bg=@34 mask=@32 mode=0 opacity=1
node 36 blend fg=@33 bg=@27 mask=@32 mode=0 opacity=1
node 37 levels in=@1 low=0 high=0.3 out_low=0.58 out_high=0.42
node 38 levels in=@49 out_low=0 out_high=0.2
node 39 blend fg=@38 bg=@37 mode=2 opacity=1
node 45 blend fg=@43 bg=@39 mode=5 opacity=0.2
node 40 blend fg=@18 bg=@45 mode=1 opacity=0.2
output basecolor 36
output height 19
output normal 20
output ambient_occlusion 21
output roughness 40
output metallic 49
output emissive 35
expose "Panels per side" 1 cols 2 8
expose "Edge wear" 49 low 0 0.6
expose "Panel seed" 1 seed 0 100
