# Polished marble with thin veins
size 2048
node 1 perlin scale=3 seed=4
node 2 liquid_noise scale=3 warp=0.6 seed=8
node 3 warp in=@1 warp=@2 intensity=0.05
node 15 levels in=@3 low=0.485 high=0.5 out_low=0 out_high=1
node 16 levels in=@3 low=0.5 high=0.515 out_low=1 out_high=0
node 4 blend fg=@15 bg=@16 mode=3 opacity=1
node 5 clouds scale=3 seed=2
node 6 colorize in=@5 p0=0 r0=0.78 g0=0.78 b0=0.8 p1=1 r1=0.96 g1=0.96 b1=0.97
node 7 color r=0.28 g=0.28 b=0.32
node 8 levels in=@4 out_low=0 out_high=0.85
node 9 blend fg=@7 bg=@6 mask=@8 mode=0 opacity=1
node 10 fbm scale=30 octaves=4 seed=3
node 11 levels in=@10 out_low=0.47 out_high=0.53
node 12 normal in=@11 strength=0.5
node 13 levels in=@8 out_low=0.12 out_high=0.3
node 14 color r=0 g=0 b=0
output basecolor 9
output height 11
output normal 12
output roughness 13
output metallic 14
expose "Vein count" 1 scale 1 8
expose "Vein turbulence" 3 intensity 0 0.4
