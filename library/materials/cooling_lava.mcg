# Cooling lava: dark cracked crust plates over glowing molten rock (uses the emissive output)
size 2048
node 1 voronoi scale=7 jitter=1 seed=5 mode=4 distortion=0.3 distortion_scale=8
node 2 levels in=@1 low=0 high=0.09
node 3 levels in=@1.distance low=0 high=0.7 out_low=1 out_high=0
node 4 fbm scale=12 octaves=6 seed=3 mode=1
node 5 blend fg=@3 bg=@2 mode=3 opacity=0.4
node 6 blend fg=@4 bg=@5 mode=5 opacity=0.35
node 7 normal in=@6 strength=5
node 8 ao in=@6 radius=6 intensity=2
node 9 invert in=@2
node 11 fbm scale=5 octaves=4 seed=9
node 12 levels in=@11 low=0.3 high=0.8 out_low=0.35 out_high=1
node 13 blend fg=@12 bg=@9 mode=3 opacity=1
node 14 colorize in=@13 p0=0 r0=0 g0=0 b0=0 p1=0.3 r1=0.55 g1=0.07 b1=0.01 p2=0.7 r2=1 g2=0.38 b2=0.04 p3=1 r3=1 g3=0.85 b3=0.4
node 15 colorize in=@6 p0=0 r0=0.03 g0=0.025 b0=0.025 p1=0.6 r1=0.11 g1=0.095 b1=0.085 p2=1 r2=0.28 g2=0.26 b2=0.24
node 16 blend fg=@14 bg=@15 mask=@13 mode=0 opacity=0.9
node 17 blend fg=@8 bg=@16 mode=3 opacity=0.6
node 18 levels in=@13 out_low=0.9 out_high=0.3
node 19 color r=0 g=0 b=0
output basecolor 17
output height 6
output normal 7
output ambient_occlusion 8
output roughness 18
output metallic 19
output emissive 14
expose "Crust plate size" 1 scale 3 16
expose "Crack width" 2 high 0.02 0.25
expose "Heat" 12 out_low 0 1
