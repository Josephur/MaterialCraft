# Dungeon wall: large rough stone blocks with chipped edges, damp streaks and moss in the joints
size 2048
node 1 bricks rows=5 cols=2 mortar=0.035 bevel=0.07 offset=0.5 lum_var=0.6 seed=4
node 2 fbm scale=12 octaves=5 seed=2
node 3 warp in=@1 warp=@2 intensity=0.06
node 4 fbm scale=8 octaves=7 seed=6 mode=1
node 5 blend fg=@4 bg=@3 mode=5 opacity=0.45
node 6 levels in=@3 low=0 high=0.05
node 7 blend fg=@6 bg=@5 mode=3 opacity=1
node 8 fbm scale=24 octaves=4 seed=9
node 9 convex_concave in=@3 radius=8 gain=5
node 10 blend fg=@8 bg=@9 mode=3 opacity=1
node 11 levels in=@10 low=0.2 high=0.35
node 12 blend fg=@11 bg=@7 mode=2 opacity=0.25
node 13 normal in=@12 strength=6
node 14 ao in=@12 radius=10 intensity=2.6
node 15 colorize in=@3 p0=0 r0=0.1 g0=0.095 b0=0.09 p1=0.05 r1=0.19 g1=0.185 b1=0.175 p2=1 r2=0.35 g2=0.335 b2=0.31
node 16 blend fg=@4 bg=@15 mode=5 opacity=0.25
node 17 moisture_noise scale=6 coverage=0.4 drips=0.7 drip_length=0.6 seed=3
node 18 color r=0.08 g=0.075 b=0.07
node 19 blend fg=@18 bg=@16 mask=@17 mode=0 opacity=0.6
node 20 invert in=@6
node 21 blend fg=@20 bg=@9.concave mode=6 opacity=1
node 22 fbm scale=7 octaves=5 seed=11
node 23 levels in=@22 low=0.42 high=0.6
node 24 blend fg=@23 bg=@21 mode=3 opacity=1
node 25 fbm scale=80 octaves=3 seed=12
node 26 colorize in=@25 p0=0 r0=0.1 g0=0.17 b0=0.04 p1=1 r1=0.24 g1=0.34 b1=0.09
node 27 blend fg=@26 bg=@19 mask=@24 mode=0 opacity=0.9
node 32 invert in=@9.concave
node 33 blend fg=@32 bg=@27 mode=3 opacity=0.5
node 28 blend fg=@14 bg=@33 mode=3 opacity=1
node 29 levels in=@17 out_low=0.93 out_high=0.62
node 30 blend fg=@24 bg=@29 mode=0 opacity=0.15
node 31 color r=0 g=0 b=0
output basecolor 28
output height 12
output normal 13
output ambient_occlusion 14
output roughness 30
output metallic 31
expose "Rows" 1 rows 2 10
expose "Columns" 1 cols 1 6
expose "Moss" 23 low 0.3 0.8
expose "Damp streaks" 17 coverage 0 1
