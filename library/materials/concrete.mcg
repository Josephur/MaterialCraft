# Poured concrete with pores and hairline noise
size 2048
node 1 clouds scale=4 seed=3
node 2 fbm scale=14 octaves=6 seed=4
node 3 grunge_map map=17 seed=6 coverage=0.78 contrast=0.9 invert=1
node 4 grunge_map map=19 seed=7 coverage=0.72 contrast=0.9 invert=1
node 5 blend fg=@2 bg=@1 mode=5 opacity=0.55
node 6 blend fg=@3 bg=@5 mode=2 opacity=0.18
node 7 blend fg=@4 bg=@6 mode=2 opacity=0.12
node 8 normal in=@7 strength=2.2
node 9 ao in=@7 radius=5 intensity=2
node 10 colorize in=@7 p0=0 r0=0.35 g0=0.35 b0=0.34 p1=0.55 r1=0.55 g1=0.55 b1=0.53 p2=1 r2=0.68 g2=0.67 b2=0.64
node 11 blend fg=@9 bg=@10 mode=3 opacity=0.8
node 12 levels in=@2 low=0.2 high=0.8 out_low=0.7 out_high=0.95
node 13 color r=0 g=0 b=0
output basecolor 11
output height 7
output normal 8
output ambient_occlusion 9
output roughness 12
output metallic 13
expose "Pore amount" 3 coverage 0.5 0.95
expose "Relief" 8 strength 0 8
