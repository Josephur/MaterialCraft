# Diamond steel floor plate: raised alternating lozenges, worn bright on top, grime around them
size 2048
node 1 tile_sampler x_amount=10 y_amount=10 size=0.78 aspect=0.26 rotation=0.125 pattern_type=14 mask_checker=1
node 2 tile_sampler x_amount=10 y_amount=10 size=0.78 aspect=0.26 rotation=0.875 pattern_type=14 mask_checker=2
node 3 blend fg=@2 bg=@1 mode=6 opacity=1
node 4 levels in=@3 low=0 high=0.55
node 5 fbm scale=30 octaves=5 seed=3
node 6 blend fg=@5 bg=@4 mode=1 opacity=0.012
node 28 levels in=@6 out_low=0.42 out_high=0.58
node 7 normal in=@6 strength=2.5
node 8 ao in=@6 radius=4 intensity=1.6
node 9 scratches count=220 length=120 thickness=1 angle_variation=1 seed=4
node 10 levels in=@9 low=0.3 high=0.6
node 11 color r=0.55 g=0.56 b=0.58
node 12 fbm scale=6 octaves=5 seed=7
node 13 blend fg=@12 bg=@11 mode=5 opacity=0.2
node 14 color r=0.7 g=0.71 b=0.72
node 15 blend fg=@14 bg=@13 mask=@4 mode=0 opacity=0.6
node 16 blend fg=@14 bg=@15 mask=@10 mode=0 opacity=0.5
node 17 invert in=@8
node 18 levels in=@17 low=0.02 high=0.25
node 19 blend fg=@12 bg=@18 mode=3 opacity=0.6
node 20 color r=0.16 g=0.15 b=0.13
node 21 blend fg=@20 bg=@16 mask=@19 mode=0 opacity=0.75
node 22 blend fg=@8 bg=@21 mode=3 opacity=0.7
node 23 levels in=@4 out_low=0.46 out_high=0.24
node 24 blend fg=@10 bg=@23 mode=2 opacity=0.1
node 25 levels in=@19 out_low=0 out_high=0.45
node 26 blend fg=@25 bg=@24 mode=1 opacity=1
node 27 levels in=@19 out_low=1 out_high=0.4
output basecolor 22
output height 28
output normal 7
output ambient_occlusion 8
output roughness 26
output metallic 27
expose "Grime" 18 high 0.05 0.6
expose "Scuffs" 9 count 0 600
