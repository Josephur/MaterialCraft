# Rough stone wall with moss in the cavities
size 2048
node 1 paving scale=5 jitter=0.8 gap=0.07 bevel=0.2 height_variation=0.45 dome=0.5 seed=8
node 2 fbm scale=9 octaves=6 seed=2 mode=0
node 3 fbm scale=50 octaves=4 seed=3
node 4 blend fg=@2 bg=@1 mode=1 opacity=0.2
node 5 blend fg=@3 bg=@4 mode=1 opacity=0.07
node 6 convex_concave in=@5 radius=14 gain=6
node 7 fbm scale=24 octaves=5 seed=9
node 8 blend fg=@7 bg=@6 mode=1 opacity=0.4
node 9 levels in=@8 low=0.35 high=0.7
node 10 normal in=@5 strength=5
node 11 ao in=@5 radius=9 intensity=2.8
node 12 colorize in=@1.cell_id p0=0 r0=0.28 g0=0.27 b0=0.25 p1=1 r1=0.5 g1=0.47 b1=0.42
node 13 colorize in=@7 p0=0 r0=0.06 g0=0.14 b0=0.03 p1=1 r1=0.22 g1=0.38 b1=0.08
node 14 blend fg=@13 bg=@12 mask=@9 mode=0 opacity=1
node 15 blend fg=@11 bg=@14 mode=3 opacity=1
node 16 levels in=@9 out_low=0.8 out_high=1
node 17 color r=0 g=0 b=0
output basecolor 15
output height 5
output normal 10
output ambient_occlusion 11
output roughness 16
output metallic 17
expose "Stone count" 1 scale 2 12
expose "Moss amount" 9 low 0.1 0.7
