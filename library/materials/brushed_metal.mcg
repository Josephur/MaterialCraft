# Brushed stainless steel: fine directional brushing with soft smudges
size 2048
node 1 anisotropic_noise scale=6 stretch=48 angle=0 octaves=6 gain=0.6 seed=2
node 2 anisotropic_noise scale=40 stretch=24 angle=0 octaves=3 seed=4
node 13 anisotropic_noise scale=150 stretch=20 angle=0 octaves=2 seed=9
node 14 blend fg=@2 bg=@1 mode=5 opacity=0.5
node 3 blend fg=@13 bg=@14 mode=5 opacity=0.35
node 4 fbm scale=4 octaves=4 seed=7
node 5 levels in=@4 low=0.58 high=0.82
node 6 color r=0.6 g=0.61 b=0.63
node 7 blend fg=@3 bg=@6 mode=5 opacity=0.16
node 8 levels in=@3 out_low=0.2 out_high=0.36
node 9 blend fg=@5 bg=@8 mode=1 opacity=0.14
node 10 levels in=@3 out_low=0.494 out_high=0.506
node 11 normal in=@10 strength=1.2
node 12 color r=1 g=1 b=1
output basecolor 7
output height 10
output normal 11
output roughness 9
output metallic 12
expose "Brushing length" 1 stretch 4 100
expose "Roughness" 8 out_low 0 0.6
expose "Smudges" 5 low 0.4 0.95
