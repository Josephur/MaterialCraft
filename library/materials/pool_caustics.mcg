# Sunlit pool floor with caustics
size 2048
node 1 caustics scale=5 strength=1.4 sharpness=1.2 seed=3
node 2 paving scale=12 jitter=0.15 gap=0.025 bevel=0.04 height_variation=0.1 dome=0 seed=2
node 3 fbm scale=14 octaves=4 seed=5
node 4 normal in=@2 strength=1.5
node 5 ao in=@2 radius=4 intensity=1.8
node 6 colorize in=@3 p0=0 r0=0.1 g0=0.34 b0=0.5 p1=1 r1=0.2 g1=0.55 b1=0.7
node 7 blend fg=@1 bg=@6 mode=4 opacity=0.65
node 8 blend fg=@5 bg=@7 mode=3 opacity=0.8
node 9 color r=0.12 g=0.12 b=0.12
node 10 levels in=@2 low=0 high=0.1
node 11 blend fg=@8 bg=@9 mask=@10 mode=0 opacity=1
node 12 color r=0.15 g=0.15 b=0.15
node 13 color r=0 g=0 b=0
output basecolor 11
output height 2
output normal 4
output ambient_occlusion 5
output roughness 12
output metallic 13
expose "Caustic strength" 1 strength 0 4
