# Cracked dry mud
size 2048
node 1 voronoi scale=9 jitter=0.9 seed=5 mode=4 distortion=0.15
node 2 voronoi scale=9 jitter=0.9 seed=5 mode=1 distortion=0.15
node 3 fbm scale=7 octaves=6 seed=3
node 4 levels in=@1 low=0.0 high=0.22 out_low=0 out_high=1
node 5 blend fg=@3 bg=@4 mode=1 opacity=0.18
node 6 normal in=@5 strength=5
node 7 ao in=@4 radius=10 intensity=3
node 8 colorize in=@5 p0=0 r0=0.08 g0=0.05 b0=0.03 p1=0.5 r1=0.35 g1=0.25 b1=0.16 p2=1 r2=0.58 g2=0.45 b2=0.32
node 9 blend fg=@2 bg=@8 mode=5 opacity=0.15
node 10 blend fg=@7 bg=@9 mode=3 opacity=1
node 11 levels in=@3 out_low=0.75 out_high=1
node 12 color r=0 g=0 b=0
output basecolor 10
output height 5
output normal 6
output ambient_occlusion 7
output roughness 11
output metallic 12
expose "Crack density" 1 scale 3 20
