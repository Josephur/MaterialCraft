# Loose gravel: rounded pebbles of mixed stone in two sizes
size 2048
node 1 voronoi scale=22 jitter=1 seed=3 mode=4 distortion=0.12 distortion_scale=4
node 2 levels in=@1.distance low=0 high=0.7 gamma=0.6 out_low=1 out_high=0
node 3 levels in=@1 low=0 high=0.2 gamma=0.7
node 4 blend fg=@3 bg=@2 mode=3 opacity=1
node 5 voronoi scale=52 jitter=1 seed=9 mode=4 distortion=0.12 distortion_scale=6
node 6 levels in=@5.distance low=0 high=0.7 gamma=0.6 out_low=1 out_high=0
node 7 levels in=@5 low=0 high=0.2 gamma=0.7
node 8 blend fg=@7 bg=@6 mode=3 opacity=1
node 9 levels in=@8 out_low=0 out_high=0.62
node 10 blend fg=@9 bg=@4 mode=6 opacity=1
node 11 colorize in=@1.cell_id interp=2 p0=0 r0=0.56 g0=0.51 b0=0.44 p1=0.22 r1=0.43 g1=0.42 b1=0.41 p2=0.45 r2=0.62 g2=0.6 b2=0.57 p3=0.66 r3=0.47 g3=0.38 b3=0.3 p4=0.84 r4=0.3 g4=0.29 b4=0.29 p5=1 r5=0.3 g5=0.29 b5=0.29
node 12 colorize in=@5.cell_id interp=2 p0=0 r0=0.5 g0=0.49 b0=0.47 p1=0.3 r1=0.6 g1=0.55 b1=0.48 p2=0.55 r2=0.36 g2=0.35 b2=0.34 p3=0.8 r3=0.52 g3=0.43 b3=0.35 p4=1 r4=0.52 g4=0.43 b4=0.35
node 13 blend fg=@4 bg=@9 mode=2 opacity=1
node 14 levels in=@13 low=0 high=0.02
node 15 blend fg=@12 bg=@11 mask=@14 mode=0 opacity=1
node 16 fbm scale=110 octaves=3 seed=5
node 17 blend fg=@16 bg=@15 mode=5 opacity=0.3
node 18 hsl in=@17 hue=0 sat=0.85 val=1
node 19 ao in=@10 radius=6 intensity=2.6
node 20 blend fg=@19 bg=@18 mode=3 opacity=1
node 21 normal in=@10 strength=6
node 22 levels in=@1.cell_id out_low=0.72 out_high=0.9
node 23 color r=0 g=0 b=0
output basecolor 20
output height 10
output normal 21
output ambient_occlusion 19
output roughness 22
output metallic 23
expose "Pebble size" 1 scale 8 60
expose "Small pebble size" 5 scale 20 120
expose "Bumpiness" 21 strength 0 12
