# Woven cloth
size 2048
node 1 wire_mesh count_x=40 count_y=40 wire_width=0.78 weave_depth=0.7 mode=0
node 2 fibers count=2400 length=24 thickness=1 curl=1.5 seed=3
node 3 fbm scale=8 octaves=4 seed=2
node 4 blend fg=@2 bg=@1 mode=1 opacity=0.1
node 5 normal in=@4 strength=3
node 6 ao in=@1 radius=3 intensity=2.2
node 7 colorize in=@4 p0=0 r0=0.04 g0=0.07 b0=0.14 p1=1 r1=0.16 g1=0.27 b1=0.5
node 8 blend fg=@3 bg=@7 mode=5 opacity=0.25
node 9 blend fg=@6 bg=@8 mode=3 opacity=0.8
node 10 levels in=@2 out_low=0.8 out_high=1
node 11 color r=0 g=0 b=0
output basecolor 9
output height 4
output normal 5
output ambient_occlusion 6
output roughness 10
output metallic 11
expose "Threads per tile" 1 count_x 8 100
