# Normal, ambient occlusion and curvature from a height map
size 1024
node 1 input idx=0 gray=1
node 2 normal in=@1 strength=3
node 3 ao in=@1 radius=8 intensity=2.2
node 4 curvature in=@1 mode=1 radius=3 intensity=4
output normal 2
output ambient_occlusion 3
output curvature 4
expose "Normal strength" 2 strength 0 10
expose "AO radius" 3 radius 1 32
