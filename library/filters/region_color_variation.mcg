# Random brightness and hue per region of a mask (input: mask), applied to a colour
size 1024
node 1 input idx=0 gray=1
node 2 flood_fill_random in=@1
node 3 flood_fill_color in=@1
node 4 color r=0.5 g=0.5 b=0.5
node 5 blend fg=@3 bg=@4 mode=5 opacity=0.4
node 6 blend fg=@2 bg=@5 mode=5 opacity=0.3
output output 6
expose "Hue variation" 5 opacity 0 1
expose "Brightness variation" 6 opacity 0 1
